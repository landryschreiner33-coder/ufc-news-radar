# ============================================================
# UFC News Radar - environment variables
# ------------------------------------------------------------
# 1. Copy this file to a file named exactly ".env"
#        Windows:  copy .env.example .env
# 2. Fill in only the keys you actually have.
# 3. NEVER commit your real .env file (it is in .gitignore).
#
# The app runs WITHOUT any of these keys. Features that need a
# key are clearly labelled "NOT CONFIGURED" in the UI instead of
# being faked.
# ============================================================

# ---------- AI provider (optional) ----------
# Used for summaries, TikTok scripts, reporting checks.
# Without a key the app uses a clearly-labelled template mode
# that is built from the collected source text only.
# Valid values: anthropic | openai | none
AI_PROVIDER=none

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override the OpenAI-compatible base URL
OPENAI_BASE_URL=

# Max characters of source material sent to the AI per request.
AI_MAX_CONTEXT_CHARS=12000

# ---------- X / Twitter API (optional) ----------
# Requires an X developer account: https://developer.x.com/
# A Bearer Token (App-only OAuth 2.0) is enough for the read
# endpoints this app uses:
#   GET /2/tweets/search/recent   (last 7 days only)
#   GET /2/users/by/username/:username
#   GET /2/users/:id/tweets
# Without this token the X panels show "NOT CONFIGURED".
X_BEARER_TOKEN=

# Free/Basic X access tiers have very small request quotas.
# These limits stop the app from burning your monthly quota.
X_MAX_SEARCHES_PER_RUN=3
X_MAX_TIMELINES_PER_RUN=5
X_MAX_RESULTS_PER_QUERY=25
# Minimum minutes between two identical X queries (cache window).
X_QUERY_CACHE_MINUTES=30

# ---------- Application ----------
# Where the SQLite database lives (relative paths are resolved
# against the project folder).
UFC_RADAR_DB=data/ufc_news_radar.db

# HTTP settings for news collection
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=UFCNewsRadar/1.0 (personal news dashboard)

# Set to 1 for verbose logging
UFC_RADAR_DEBUG=0
