.streamlit/secrets.toml
secrets.toml

# Local database + caches (regenerated on demand)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/cache/
logs/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Stray artefact of the dev restart helper - never belongs in git.
app.pid
